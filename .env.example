DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google OAuth (Backend verification)
# Use the Google Web Client ID from Google Cloud OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google OAuth (Frontend button/provider)
# Vite exposes only vars prefixed with VITE_
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Database configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# Redis configuration (Upstash Redis / local)
# Note: Use rediss:// (with double 's') to connect via TLS/SSL to Upstash
REDIS_URL=rediss://default:password@hostname:port
